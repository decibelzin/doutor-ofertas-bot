{
  "name": "doutor-ofertas-bot",
  "version": "0.1.0",
  "description": "Bot de ofertas de afiliado. Fase 1: canal WhatsApp (conectar + postar com throttle anti-ban).",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "connect": "tsx src/cli/connect.ts",
    "list-groups": "tsx src/cli/list-groups.ts",
    "send-test": "tsx src/cli/send-test.ts",
    "ml-auth": "tsx src/cli/ml-auth.ts",
    "fetch": "tsx src/cli/fetch.ts",
    "post-now": "tsx src/cli/post-now.ts",
    "update-perfumes": "tsx src/cli/update-perfumes.ts",
    "post-coupon": "tsx src/cli/post-coupon.ts",
    "discover-coupons": "tsx src/cli/discover-coupons.ts",
    "post-perfume-coupon": "tsx src/cli/post-perfume-coupon.ts",
    "coupon-probe": "tsx src/cli/coupon-probe.ts",
    "ml-link": "tsx src/cli/ml-link.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@whiskeysockets/baileys": "^6.7.9",
    "cheerio": "^1.2.0",
    "dotenv": "^16.4.7",
    "luxon": "^3.5.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.10.5",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
