# ============================================================================
#  doutor-ofertas-bot — configuração (copie para .env)
# ============================================================================

# ----- Geral -----
LOG_LEVEL=info
TIMEZONE=America/Sao_Paulo

# ----- WhatsApp -----
# Pasta onde a sessão do WhatsApp fica salva (para não escanear o QR toda vez).
SESSION_DIR=./data/auth

# IDs dos grupos-alvo, separados por vírgula.
# Descubra rodando: npm run list-groups  (depois de conectar com npm run connect)
# Ex.: 120363012345678901@g.us,120363098765432109@g.us
WHATSAPP_GROUP_IDS=

# ----- Agendamento / cadência -----
# Janela de postagem (hora local do TIMEZONE). Fora dela o bot não posta.
START_HOUR=8
END_HOUR=22
# Intervalo-base entre postagens (minutos) e variação aleatória (± jitter).
POST_INTERVAL_MINUTES=8
POST_JITTER_MINUTES=3
# Tetos de segurança (anti-ban). MAX_POSTS_PER_DAY vazio = sem limite diário.
MAX_POSTS_PER_HOUR=8
MAX_POSTS_PER_DAY=
# Não repostar a mesma oferta dentro de N dias.
DEDUP_COOLDOWN_DAYS=3
# Arquivo de histórico/dedup.
STORE_FILE=./data/posted.json

# ----- Anti-ban (throttle de envio entre grupos) -----
# Delay aleatório (ms) entre enviar para um grupo e o próximo.
# 5-20s: rápido (todos os grupos em ~1-2 min) sem o padrão de "robô simultâneo".
# Aumente para 30000/90000 se tiver MUITOS grupos ou o número for novo/frio.
GROUP_DELAY_MIN_MS=5000
GROUP_DELAY_MAX_MS=20000

# ============================================================================
#  PROVIDERS (fontes de ofertas — entram na fase de ofertas)
# ============================================================================

# ----- Shopee (provider âncora — Shopee Affiliate Open API) -----
# Credenciais em https://affiliate.shopee.com.br -> "Open API".
# Ativa sozinho quando App ID + Secret estão preenchidos.
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=
SHOPEE_GRAPHQL_ENDPOINT=https://open-api.affiliate.shopee.com.br/graphql
# Termos de busca (vírgula). Vazio = usa categorias padrão.
SHOPEE_SEARCH_TERMS=
SHOPEE_MIN_DISCOUNT_PERCENT=20
# sortType: 5 = maior comissão, 2 = mais vendidos.
SHOPEE_SORT_TYPE=5
SHOPEE_LIMIT_PER_TERM=20
SHOPEE_FALLBACK_COUPON=

# ----- Mercado Livre (developers.mercadolivre.com.br) -----
# Ligue com ML_ENABLED=true depois de rodar "npm run ml-auth".
ML_ENABLED=false
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=https://example.com
ML_TOKEN_FILE=./data/ml_token.json
ML_SITE_ID=MLB
# Termos de busca (vírgula). Vazio = usa um conjunto padrão de categorias.
ML_SEARCH_TERMS=
# Desconto mínimo (%) pra considerar a oferta.
ML_MIN_DISCOUNT_PERCENT=15
# Link de afiliado: 'matt' anexa matt_word/matt_tool na URL do produto.
# Pegue os valores gerando UM link na Central de Afiliados e lendo a URL.
ML_LINK_MODE=matt
ML_MATT_WORD=
ML_MATT_TOOL=
# Alternativa (fallback) se você só tiver uma tag única em vez de matt_word/tool:
ML_SIMPLE_TAG=
# Link curto OFICIAL (meli.la) via endpoint interno createLink.
# Capture do painel de afiliado (F12 -> Rede -> clique em Compartilhar ->
# requisição "createLink" -> Copiar como cURL): pegue o header x-csrf-token e o
# Cookie inteiro. EXPIRAM com o tempo -> recapturar quando o bot avisar.
# Sem eles, o bot usa o link matt (longo) automaticamente.
ML_AFFILIATE_CSRF=
ML_AFFILIATE_COOKIE=
