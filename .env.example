# ============================================================================
#  doutor-ofertas-bot — configuração (copie para .env)
# ============================================================================

# ----- Geral -----
LOG_LEVEL=info
TIMEZONE=America/Sao_Paulo

# ----- WhatsApp -----
# Pasta onde a sessão do WhatsApp fica salva (para não escanear o QR toda vez).
SESSION_DIR=./data/auth

# IDs dos grupos-alvo, separados por vírgula.
# Descubra rodando: npm run list-groups  (depois de conectar com npm run connect)
# Ex.: 120363012345678901@g.us,120363098765432109@g.us
WHATSAPP_GROUP_IDS=

# ----- Anti-ban (throttle de envio) -----
# Delay aleatório (ms) entre enviar para um grupo e o próximo.
GROUP_DELAY_MIN_MS=30000
GROUP_DELAY_MAX_MS=90000
