# ============================================================================
#  doutor-ofertas-bot - configuração (copie para .env)
# ============================================================================

# ----- Geral -----
LOG_LEVEL=info
TIMEZONE=America/Sao_Paulo

# ----- WhatsApp -----
# Pasta onde a sessão do WhatsApp fica salva (para não escanear o QR toda vez).
SESSION_DIR=./data/auth

# FONTE DOS GRUPOS = config/niches.json (por nicho) - é de lá que o bot posta.
# WHATSAPP_GROUP_IDS abaixo é só FALLBACK (se niches.json não existir) e para o
# `npm run send-test`. Se você usa niches.json, deixe VAZIO (evita a confusão de
# ter grupos em dois lugares). Descubra IDs com: npm run list-groups
# Ex.: 120363012345678901@g.us,120363098765432109@g.us
WHATSAPP_GROUP_IDS=

# ----- Agendamento / cadência -----
# Janela de postagem (hora local do TIMEZONE). Fora dela o bot não posta.
START_HOUR=8
END_HOUR=22
# Intervalo-base entre postagens (minutos) e variação aleatória (± jitter).
POST_INTERVAL_MINUTES=8
POST_JITTER_MINUTES=3
# Tetos de segurança (anti-ban). MAX_POSTS_PER_DAY vazio = sem limite diário.
MAX_POSTS_PER_HOUR=8
MAX_POSTS_PER_DAY=
# Não repostar a mesma oferta dentro de N dias.
DEDUP_COOLDOWN_DAYS=3
# EXCEÇÃO ao cooldown: se a MESMA oferta voltar com desconto N pontos melhor que
# o já postado (re-preço quente), reposta mesmo dentro do cooldown. 0 = desliga.
DEDUP_REPRICE_BYPASS_POINTS=10
# Arquivo de histórico/dedup.
STORE_FILE=./data/posted.json
# Grupo/chat (JID …@g.us) que recebe alertas de saúde (ex.: cookie do ML expirou).
# Vazio = só loga no console. Descubra o JID com: npm run list-groups.
ADMIN_ALERT_GROUP=

# ----- Moderação por reação (vetar produto) -----
# Reagir com um destes emojis num anúncio VETA aquele PRODUTO pra sempre (nunca
# mais posta). Só o produto daquele anúncio - não a marca. Vazio = usa o padrão
# (❌ ✖️ ✖ 🚫 ❎). O bot precisa estar RODANDO na hora da reação.
MODERATION_BLOCK_EMOJIS=
# A reação da PRÓPRIA conta do bot já vale sempre. Aqui você autoriza números
# EXTRA a moderar (ex.: seu celular pessoal), separados por vírgula (só dígitos
# ou JID). Vazio = só a conta do bot modera.
MODERATION_MODERATOR_JIDS=

# ----- Anti-ban (throttle de envio entre grupos) -----
# Delay aleatório (ms) entre enviar para um grupo e o próximo.
# 5-20s: rápido (todos os grupos em ~1-2 min) sem o padrão de "robô simultâneo".
# Aumente para 30000/90000 se tiver MUITOS grupos ou o número for novo/frio.
GROUP_DELAY_MIN_MS=5000
GROUP_DELAY_MAX_MS=20000

# ============================================================================
#  PROVIDERS (fontes de ofertas - entram na fase de ofertas)
# ============================================================================

# ----- Shopee (provider âncora - Shopee Affiliate Open API) -----
# Credenciais em https://affiliate.shopee.com.br -> "Open API".
# Ativa sozinho quando App ID + Secret estão preenchidos.
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=
SHOPEE_GRAPHQL_ENDPOINT=https://open-api.affiliate.shopee.com.br/graphql
# Termos de busca (vírgula). Vazio = usa categorias padrão.
SHOPEE_SEARCH_TERMS=
SHOPEE_MIN_DISCOUNT_PERCENT=20
# sortType: 5 = maior comissão, 2 = mais vendidos.
SHOPEE_SORT_TYPE=5
SHOPEE_LIMIT_PER_TERM=20
SHOPEE_FALLBACK_COUPON=

# ----- Mercado Livre (developers.mercadolivre.com.br) -----
# Ligue com ML_ENABLED=true depois de rodar "npm run ml-auth".
ML_ENABLED=false
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=https://example.com
ML_TOKEN_FILE=./data/ml_token.json
ML_SITE_ID=MLB
# Termos de busca (vírgula). Vazio = usa um conjunto padrão de categorias.
ML_SEARCH_TERMS=
# Desconto mínimo (%) pra considerar a oferta.
ML_MIN_DISCOUNT_PERCENT=15
# Quantas páginas (12 itens cada) buscar por termo no hub. 2-3 alarga a cobertura
# (evita slot vazio); mais que isso = mais tráfego autenticado na sua sessão do ML.
ML_HUB_PAGES_PER_TERM=2
# BUSCA PÚBLICA (lista.mercadolivre.com.br) como 2ª fonte = MUITO mais volume
# (48/página vs ~12 do hub) → evita "secar" o estoque. Exige o mesmo cookie do
# painel. Páginas por termo (0 desliga). TTL = raspa 1x por esse tempo (não a
# cada post) pra controlar o tráfego autenticado.
ML_SEARCH_PAGES_PER_TERM=2
ML_SEARCH_TTL_MINUTES=25
# Link de afiliado: 'matt' anexa matt_word/matt_tool na URL do produto.
# Pegue os valores gerando UM link na Central de Afiliados e lendo a URL.
ML_LINK_MODE=matt
ML_MATT_WORD=
ML_MATT_TOOL=
# Alternativa (fallback) se você só tiver uma tag única em vez de matt_word/tool:
ML_SIMPLE_TAG=
# Link curto OFICIAL (meli.la) via endpoint interno createLink.
# Capture do painel de afiliado (F12 -> Rede -> clique em Compartilhar ->
# requisição "createLink" -> Copiar como cURL): pegue o header x-csrf-token e o
# Cookie inteiro. EXPIRAM com o tempo -> recapturar quando o bot avisar.
# Sem eles, o bot usa o link matt (longo) automaticamente.
ML_AFFILIATE_CSRF=
ML_AFFILIATE_COOKIE=

# ----- Cupom (perfume + cupom automático = "desconto duplo") -----
# Usa a MESMA auth de painel acima (ML_AFFILIATE_COOKIE/CSRF). Quando presente,
# o bot (npm run start) descobre cupons de perfumaria e posta perfume+cupom
# sozinho, junto das ofertas. COUPON_AUTO=false desliga (mantém os comandos
# manuais: npm run discover-coupons / npm run post-perfume-coupon).
COUPON_AUTO=true
# De quanto em quanto tempo atualizar o cache de cupons (horas). Menor = capta
# cupom novo mais rápido, mas mais tráfego autenticado na sua sessão do ML.
COUPON_DISCOVERY_INTERVAL_HOURS=8
# Intervalo entre posts de cupom (min). Ainda respeita MAX_POSTS_PER_HOUR/DAY.
COUPON_POST_INTERVAL_MINUTES=90
# Teto de páginas por varredura (~507 = pool inteiro de cupons).
COUPON_MAX_PAGES=600
# Banner fixo (imagem) do cupom relâmpago manual - NÃO usado no post automático.
COUPON_BANNER_PATH=
# Link opcional no rodapé do post de cupom (ex.: meli.la de uma busca).
COUPON_SEARCH_LINK=

# ----- Site (bot e site na MESMA VPS) -----
# Caminho do JSON que o site le. Na VPS aponte pra pasta servida pelo nginx,
# ex.: /var/www/doutorofertas/groups.json
SITE_GROUPS_FILE=./website/groups.json
# Teto OPERACIONAL por grupo (WhatsApp permite 1024; a folga evita corrida).
SITE_GROUP_LIMIT=1000
# De quanto em quanto tempo atualizar (min). 0 desliga.
SITE_REFRESH_MINUTES=15

# SITE_DIR: raiz servida pelo nginx. Cada nicho vira <SITE_DIR>/<slug>/.
# Default: a pasta de SITE_GROUPS_FILE. Ex.: /var/www/doutoroferta
# SITE_DIR=./website

# ----- Discord (bot de comandos; processo separado do WhatsApp) -----
# Token em Developer Portal -> sua aplicacao -> Bot -> Reset Token.
# NUNCA commitar: o .env e gitignored de proposito.
DISCORD_TOKEN=
# ID da aplicacao (Developer Portal -> General Information -> Application ID).
DISCORD_CLIENT_ID=
# Servidor onde os slash commands sao registrados. Registro por guild aparece
# na hora; o global leva ate 1h pra propagar.
DISCORD_GUILD_ID=

# Logs do nginx que alimentam o /funil. Na VPS sao estes; local, aponte pra
# uma copia se quiser testar com dado real.
# SITE_LOG_ACESSOS=/var/log/nginx/doutoroferta-acessos.log
# SITE_LOG_CLIQUES=/var/log/nginx/doutoroferta-cliques.log

# Webhook do Discord pros alertas de saude (Canal -> Editar -> Integracoes ->
# Webhooks -> Novo webhook -> Copiar URL). Vazio = alerta so no log.
DISCORD_WEBHOOK_ALERTAS=

# Numeros da equipe (so digitos, virgula) que NAO contam como inscritos na
# metrica de grupos. Sem isso, voce mesmo dentro do grupo aparece como publico.
# Ex.: TEAM_NUMBERS=5511999998888
TEAM_NUMBERS=
